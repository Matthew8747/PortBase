# Copy to .env.local for development, and set the same keys in Vercel for production.
# Nothing here is required to run the site — the CV request form degrades to an honest
# "not connected yet" message when the email keys are missing.

# Public site URL. Used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL="https://mattpearson.dev"

# Resend — https://resend.com. Free tier is plenty for CV requests.
RESEND_API_KEY=""

# Where CV requests are delivered. Your real inbox; never rendered on the site.
CV_REQUEST_TO=""

# The From address. Must be on a domain verified in Resend.
# Until a domain is verified, Resend's shared sender works for testing:
CV_REQUEST_FROM="CV requests <onboarding@resend.dev>"
